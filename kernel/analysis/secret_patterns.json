{
  "_comment": [
    "呢個表係數據,唔係 code。搬出嚟嘅理由:一個 adopter 要加自己嘅 credential 家族",
    "(目標 repo 有四個一個都對唔上:Meta EAA… token、Telegram bot token、",
    "32-hex api_hash、generic hex HMAC key),而佢唔應該要改 kernel 先做到。",
    "kernel/analysis/structural_lint.py 冇跟住搬,因為嗰三條規則係 AST walker —— ",
    "係 code,唔係扮成 code 嘅數據。",
    "一個 adopter 喺自己 repo 寫 .v4/secret_patterns.json,佢啲 row 同呢度合併",
    "(union,唔係取代 —— 同 protected_paths 一樣嘅理由)。"
  ],
  "patterns": [
    {
      "id": "shopify_admin",
      "label": "Shopify Admin API token",
      "kind": "provider",
      "regex": "shpat_[A-Za-z0-9]{32,}",
      "order": 1,
      "prefix": "shpat_"
    },
    {
      "id": "shopify_storefront",
      "label": "Shopify Storefront token",
      "kind": "provider",
      "regex": "shpss_[A-Za-z0-9]{32,}",
      "order": 2,
      "prefix": "shpss_"
    },
    {
      "id": "anthropic",
      "label": "Anthropic API key",
      "kind": "provider",
      "regex": "\\bsk-ant-[A-Za-z0-9_-]{32,}\\b",
      "order": 3,
      "prefix": "sk-ant-"
    },
    {
      "id": "openai",
      "label": "OpenAI API key",
      "kind": "provider",
      "regex": "\\bsk-[A-Za-z0-9_-]{32,}\\b",
      "order": 4,
      "prefix": "sk-"
    },
    {
      "id": "aws_access_key",
      "label": "AWS Access Key ID",
      "kind": "provider",
      "regex": "\\bAKIA[A-Z0-9]{16}\\b",
      "order": 5,
      "prefix": "AKIA"
    },
    {
      "id": "github_pat_fine",
      "label": "GitHub PAT (fine-grained)",
      "kind": "provider",
      "regex": "\\bgithub_pat_[A-Za-z0-9_]{22,}\\b",
      "order": 6,
      "prefix": "github_pat_"
    },
    {
      "id": "github_pat_classic",
      "label": "GitHub PAT (classic)",
      "kind": "provider",
      "regex": "\\bghp_[A-Za-z0-9]{36}\\b",
      "order": 7,
      "prefix": "ghp_"
    },
    {
      "id": "google_api",
      "label": "Google API Key",
      "kind": "provider",
      "regex": "\\bAIza[A-Za-z0-9_-]{35}\\b",
      "order": 8,
      "prefix": "AIza"
    },
    {
      "id": "slack",
      "label": "Slack Token",
      "kind": "provider",
      "regex": "\\bxox[bpoas]-[A-Za-z0-9-]{10,}\\b",
      "order": 9,
      "prefix": "xox?-"
    },
    {
      "id": "stripe_live",
      "label": "Stripe Live Secret Key",
      "kind": "provider",
      "regex": "\\bsk_live_[A-Za-z0-9]{24,}\\b",
      "order": 10,
      "prefix": "sk_live_"
    },
    {
      "id": "private_key",
      "label": "Private Key block",
      "kind": "private-key",
      "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
      "order": 11,
      "prefix": ""
    },
    {
      "id": "uri_credentials",
      "label": "URI userinfo credentials",
      "kind": "uri",
      "regex": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^\\s/@:]+:[^\\s/@]+@",
      "order": 12,
      "prefix": ""
    }
